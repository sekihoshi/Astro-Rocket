---
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses Header + Footer with content page configuration
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import type { Thing, WithContext } from 'schema-dts';

interface Props {
  title?: string;
  description?: string;
  keywords?: string | string[];
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
  extraSchemas?: WithContext<Thing>[];
  showScrollProgress?: boolean;
  eagerReveal?: boolean;
}

const {
  title,
  description,
  keywords,
  image,
  imageAlt,
  noindex,
  nofollow,
  includeOrgSchema = false,
  extraSchemas = [],
  showScrollProgress = false,
  eagerReveal = false,
} = Astro.props;

---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  includeOrgSchema={includeOrgSchema}
  extraSchemas={extraSchemas}
  eagerReveal={eagerReveal}
>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    variant="solid"
    size="lg"
    showActiveState
    showCta={false}
    showThemeToggle={false}
    showThemeSelector={false}
    showLanguageSwitcher={false}
    showScrollProgress={showScrollProgress}
  />

  <main class="min-h-screen pt-16">
    <slot />
  </main>

  <Footer slot="footer" layout="simple" />
</BaseLayout>
