---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { createBreadcrumbSchema, createFAQSchema } from '@/lib/schema';
import siteConfig from '@/config/site.config';
import { brandNav, type BrandPageData } from '../data/pages';
import type { Thing, WithContext } from 'schema-dts';

interface Props {
  page: BrandPageData;
}

const { page } = Astro.props;
const pageUrl = new URL(page.path, siteConfig.url).toString();
const breadcrumb = createBreadcrumbSchema([
  { name: '首页', url: siteConfig.url },
  { name: page.title, url: pageUrl },
]);
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': page.kind === 'contact' ? 'ContactPage' : 'WebPage',
  name: page.seoTitle,
  description: page.description,
  url: pageUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: siteConfig.name,
    url: siteConfig.url,
  },
  about: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.url,
  },
} as WithContext<Thing>;
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${page.title}清单`,
  itemListElement: page.sections.flatMap((section) => section.items).map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.title,
    description: item.text,
  })),
} as WithContext<Thing>;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${siteConfig.name}${page.title}`,
  provider: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.url,
  },
  url: pageUrl,
  areaServed: '中国',
  description: page.description,
  serviceType: page.title,
} as WithContext<Thing>;
const extraSchemas = [webPageSchema, breadcrumb, itemListSchema, serviceSchema, createFAQSchema(page.faqs)];
const visualWords = {
  services: ['Strategy', 'Shoot', 'Edit', 'Review'],
  cases: ['Brief', 'Scene', 'Asset', 'Result'],
  solutions: ['Industry', 'Intent', 'Channel', 'Growth'],
  about: ['Team', 'Method', 'Craft', 'Trust'],
  contact: ['Brief', 'Budget', 'Timeline', 'Next'],
  resources: ['Script', 'Shotlist', 'Template', 'Audit'],
  process: ['Scope', 'Plan', 'Produce', 'Deliver'],
}[page.kind];
const allItems = page.sections.flatMap((section) => section.items);
const mediaByKind = {
  services: {
    hero: 'https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?auto=format&fit=crop&w=1800&q=84',
    feature: 'https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?auto=format&fit=crop&w=1200&q=82',
    alt: '视频制作团队在监视器前检查拍摄画面',
    thumbs: [
      'https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=800&q=82',
    ],
  },
  cases: {
    hero: 'https://images.unsplash.com/photo-1551817958-d9d86fb29431?auto=format&fit=crop&w=1800&q=84',
    feature: 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1200&q=82',
    alt: '团队在墙面上整理品牌视频案例素材',
    thumbs: [
      'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=800&q=82',
    ],
  },
  solutions: {
    hero: 'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1800&q=84',
    feature: 'https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=1200&q=82',
    alt: '团队围绕行业内容方案进行讨论',
    thumbs: [
      'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1542744094-3a31f272c490?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=800&q=82',
    ],
  },
  about: {
    hero: 'https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=1800&q=84',
    feature: 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1200&q=82',
    alt: '视频内容团队围坐讨论项目方案',
    thumbs: [
      'https://images.unsplash.com/photo-1556761175-4b46a572b786?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&w=800&q=82',
    ],
  },
  contact: {
    hero: 'https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=1800&q=84',
    feature: 'https://images.unsplash.com/photo-1553877522-43269d4ea984?auto=format&fit=crop&w=1200&q=82',
    alt: '项目沟通会议中打开的品牌简报文档',
    thumbs: [
      'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=800&q=82',
    ],
  },
  resources: {
    hero: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&w=1800&q=84',
    feature: 'https://images.unsplash.com/photo-1516321497487-e288fb19713f?auto=format&fit=crop&w=1200&q=82',
    alt: '桌面上摊开的脚本、拍摄清单和项目资料',
    thumbs: [
      'https://images.unsplash.com/photo-1516321497487-e288fb19713f?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=800&q=82',
    ],
  },
  process: {
    hero: 'https://images.unsplash.com/photo-1542744094-24638eff58bb?auto=format&fit=crop&w=1800&q=84',
    feature: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1200&q=82',
    alt: '项目管理看板上排列的视频制作流程节点',
    thumbs: [
      'https://images.unsplash.com/photo-1542744094-3a31f272c490?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=800&q=82',
      'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=800&q=82',
    ],
  },
};
const media = mediaByKind[page.kind];
---

<BaseLayout
  title={page.seoTitle}
  description={page.description}
  keywords={page.keywords}
  includeOrgSchema
  extraSchemas={extraSchemas}
>
  <header slot="header" class="brand-nav">
    <a class="brand-link" href="/" aria-label="蘑菇视频首页">
      <span class="brand-mark"><Icon name="play" size="sm" /></span>
      <span>蘑菇视频</span>
    </a>
    <nav aria-label="品牌站导航">
      {brandNav.map((item) => <a class={item.path === page.path ? 'active' : ''} href={item.path}>{item.navLabel}</a>)}
    </nav>
    <a class="nav-action" href="/contact/">
      <Icon name="send" size="sm" />
      咨询
    </a>
  </header>

  <main class={`brand-page page-${page.kind}`}>
    <section class="page-hero" style={`--hero-image: url("${media.hero}")`}>
      <div class="hero-copy" data-reveal>
        <p class="kicker">{page.eyebrow}</p>
        <h1>{page.title}</h1>
        <p class="lead">{page.lead}</p>
        <div class="hero-actions">
          <a class="primary" href="/contact/">{page.primaryCta}<Icon name="arrow-right" size="sm" /></a>
          <a class="secondary" href={page.kind === 'process' ? '/services/' : '/process/'}>{page.secondaryCta}</a>
        </div>
      </div>

      <aside class="hero-panel" data-reveal="left" aria-label={`${page.title}简报`}>
        <div class="panel-top">
          <span>Brand Brief</span>
          <Icon name="aperture" size="md" />
        </div>
        <div class="panel-display">
          <strong>{page.navLabel}</strong>
          <small>{page.eyebrow}</small>
        </div>
        <figure class="hero-image-card">
          <img src={media.feature} alt={media.alt} loading="eager" />
        </figure>
        <ul>
          {page.heroPoints.map((point) => (
            <li><Icon name="check" size="sm" />{point}</li>
          ))}
        </ul>
        <div class="panel-tags" aria-hidden="true">
          {visualWords.map((word) => <span>{word}</span>)}
        </div>
      </aside>
    </section>

    <section class="stats-band" aria-label={`${page.title}数据`}>
      {page.stats.map((stat) => (
        <div>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
          <i aria-hidden="true"></i>
        </div>
      ))}
    </section>

    {page.kind === 'services' && (
      <section class="content-section service-lab">
        <div class="section-head">
          <p class="kicker">{page.sections[0].kicker}</p>
          <h2>{page.sections[0].title}</h2>
          <p>{page.sections[0].body}</p>
        </div>
        <figure class="service-showcase">
          <img src={media.feature} alt={media.alt} loading="lazy" />
          <figcaption>
            <span>{page.sections[1].kicker}</span>
            <strong>{page.sections[1].title}</strong>
            <p>{page.sections[1].body}</p>
          </figcaption>
        </figure>
        <div class="service-matrix">
          {allItems.map((item, index) => (
            <article class={index === 0 ? 'featured' : ''}>
              <img src={media.thumbs[index % media.thumbs.length]} alt={`${item.title}相关制作场景`} loading="lazy" />
              <b>{String(index + 1).padStart(2, '0')}</b>
              {item.meta && <span>{item.meta}</span>}
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {page.kind === 'cases' && (
      <section class="content-section case-index">
        <div class="case-feature">
          <figure>
            <img src={media.feature} alt={media.alt} loading="lazy" />
          </figure>
          <p class="kicker">{page.sections[0].kicker}</p>
          <h2>{page.sections[0].title}</h2>
          <p>{page.sections[0].body}</p>
        </div>
        <div class="case-list">
          {allItems.map((item, index) => (
            <article>
              <img src={media.thumbs[index % media.thumbs.length]} alt={`${item.title}案例封面`} loading="lazy" />
              <span>{item.meta || `Case ${String(index + 1).padStart(2, '0')}`}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <Icon name="arrow-up-right" size="sm" />
            </article>
          ))}
        </div>
      </section>
    )}

    {page.kind === 'solutions' && (
      <section class="content-section solution-map">
        <div class="section-head compact">
          <p class="kicker">{page.sections[0].kicker}</p>
          <h2>{page.sections[0].title}</h2>
          <p>{page.sections[0].body}</p>
        </div>
        <div class="solution-rows">
          {allItems.map((item, index) => (
            <article>
              <img src={media.thumbs[index % media.thumbs.length]} alt={`${item.title}行业场景`} loading="lazy" />
              <strong>{String(index + 1).padStart(2, '0')}</strong>
              <div>
                <span>{item.meta || page.sections[index > 2 ? 1 : 0].kicker}</span>
                <h3>{item.title}</h3>
              </div>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {page.kind === 'about' && (
      <section class="content-section about-story">
        <div class="about-manifesto">
          <p class="kicker">{page.sections[0].kicker}</p>
          <h2>{page.sections[0].title}</h2>
          <p>{page.sections[0].body}</p>
          <figure>
            <img src={media.feature} alt={media.alt} loading="lazy" />
          </figure>
        </div>
        <div class="studio-columns">
          {allItems.map((item, index) => (
            <article>
              <img src={media.thumbs[index % media.thumbs.length]} alt={`${item.title}团队工作画面`} loading="lazy" />
              <Icon name={index < 3 ? 'users' : 'badge-check'} size="md" />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {page.kind === 'contact' && (
      <section class="content-section contact-brief">
        <div class="brief-form">
          <figure>
            <img src={media.feature} alt={media.alt} loading="lazy" />
          </figure>
          <p class="kicker">{page.sections[0].kicker}</p>
          <h2>{page.sections[0].title}</h2>
          {page.sections[0].items.map((item) => (
            <label>
              <span>{item.title}</span>
              <p>{item.text}</p>
            </label>
          ))}
        </div>
        <div class="contact-route">
          <p>{page.sections[1].body}</p>
          {page.sections[1].items.map((item, index) => (
            <article>
              <img src={media.thumbs[index % media.thumbs.length]} alt={`${item.title}沟通场景`} loading="lazy" />
              <b>{String(index + 1).padStart(2, '0')}</b>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {page.kind === 'resources' && (
      <section class="content-section resource-library">
        <div class="resource-intro">
          <div class="section-head">
            <p class="kicker">{page.sections[0].kicker}</p>
            <h2>{page.sections[0].title}</h2>
            <p>{page.sections[0].body}</p>
          </div>
          <figure>
            <img src={media.feature} alt={media.alt} loading="lazy" />
          </figure>
        </div>
        <div class="resource-shelf">
          {allItems.map((item, index) => (
            <article>
              <img src={media.thumbs[index % media.thumbs.length]} alt={`${item.title}资料预览`} loading="lazy" />
              <div><Icon name="file-text" size="md" /><span>{`0${index + 1}`}</span></div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <a href="/contact/">获取模板<Icon name="download" size="sm" /></a>
            </article>
          ))}
        </div>
      </section>
    )}

    {page.kind === 'process' && (
      <section class="content-section process-system">
        <div class="section-head compact">
          <p class="kicker">{page.sections[0].kicker}</p>
          <h2>{page.sections[0].title}</h2>
          <p>{page.sections[0].body}</p>
        </div>
        <figure class="process-board">
          <img src={media.feature} alt={media.alt} loading="lazy" />
        </figure>
        <div class="process-timeline">
          {allItems.map((item, index) => (
            <article>
              <img src={media.thumbs[index % media.thumbs.length]} alt={`${item.title}流程场景`} loading="lazy" />
              <b>{String(index + 1).padStart(2, '0')}</b>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="faq-section">
      <div class="section-head compact" data-reveal>
        <p class="kicker">FAQ</p>
        <h2>关于{page.title}的常见问题</h2>
      </div>
      <div class="faq-list">
        {page.faqs.map((faq) => (
          <details data-reveal>
            <summary>{faq.question}<Icon name="chevron-down" size="sm" /></summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="page-cta">
      <div>
        <p class="kicker">Next Step</p>
        <h2>让我们根据你的业务目标给出下一步建议</h2>
        <p>把品牌、产品、账号链接或现有素材发给我们，团队会判断最适合先做哪一类视频内容。</p>
        <a class="primary" href="/contact/">联系顾问<Icon name="mail" size="sm" /></a>
      </div>
      <aside aria-hidden="true">
        {visualWords.map((word) => <span>{word}</span>)}
      </aside>
    </section>
  </main>
</BaseLayout>

<style>
  :global(html) {
    scroll-padding-top: 92px;
  }

  :global(body) {
    font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", var(--font-sans), sans-serif;
    background: #fffaf3;
  }

  .brand-nav {
    position: fixed;
    top: 18px;
    left: 50%;
    z-index: 50;
    display: flex;
    width: min(1120px, calc(100% - 32px));
    transform: translateX(-50%);
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border: 1px solid rgba(255, 250, 243, 0.2);
    border-radius: 999px;
    background: rgba(20, 14, 10, 0.92);
    color: #fffaf3;
    padding: 10px 12px 10px 18px;
    box-shadow: 0 24px 70px rgba(20, 14, 10, 0.3);
    backdrop-filter: blur(20px);
  }

  .brand-link,
  .nav-action,
  .brand-nav nav a,
  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-link {
    gap: 10px;
    color: #fffaf3;
    font-weight: 950;
  }

  .brand-mark {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 12px;
    background: #e8431f;
    color: #fffaf3;
  }

  .brand-nav nav {
    display: flex;
    gap: 4px;
  }

  .brand-nav nav a {
    border-radius: 999px;
    color: rgba(255, 250, 243, 0.82);
    font-size: 14px;
    font-weight: 850;
    padding: 9px 11px;
  }

  .brand-nav nav a:hover,
  .brand-nav nav a.active {
    background: rgba(255, 250, 243, 0.12);
    color: #fffaf3;
  }

  .nav-action {
    gap: 8px;
    border-radius: 999px;
    background: #fffaf3;
    color: #211713;
    font-size: 14px;
    font-weight: 950;
    padding: 10px 16px;
  }

  .brand-page {
    overflow: hidden;
    background: #fffaf3;
    color: #211713;
  }

  .page-hero {
    display: grid;
    min-height: 88vh;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.54fr);
    align-items: center;
    gap: clamp(36px, 7vw, 92px);
    background:
      linear-gradient(105deg, rgba(20, 14, 10, 0.98), rgba(20, 14, 10, 0.92) 52%, rgba(139, 38, 17, 0.74)),
      url("https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?auto=format&fit=crop&w=1800&q=82") center/cover;
    color: #fffaf3;
    padding: 126px max(24px, calc((100vw - 1180px) / 2)) 88px;
  }

  .kicker {
    margin: 0;
    color: #b83216;
    font-size: 13px;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-hero .kicker,
  .page-cta .kicker {
    color: #ffc457;
  }

  h1,
  h2,
  h3,
  p {
    letter-spacing: 0;
  }

  .page-hero :is(h1, h2, h3, h4, h5, h6),
  .hero-panel :is(h1, h2, h3, h4, h5, h6),
  .page-cta :is(h1, h2, h3, h4, h5, h6) {
    color: #fffaf3;
    -webkit-text-fill-color: #fffaf3;
  }

  .page-hero h1 {
    max-width: 820px;
    margin: 18px 0 22px;
    font-size: clamp(44px, 7vw, 88px);
    font-weight: 950;
    line-height: 1.02;
  }

  .lead {
    max-width: 700px;
    margin: 0;
    color: rgba(255, 250, 243, 0.88);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.85;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .primary,
  .secondary {
    justify-content: center;
    gap: 10px;
    min-height: 54px;
    border-radius: 999px;
    font-weight: 950;
    padding: 0 24px;
  }

  .primary {
    background: #e8431f;
    color: #fffaf3;
    box-shadow: 0 20px 44px rgba(232, 67, 31, 0.28);
  }

  .secondary {
    border: 1px solid rgba(255, 250, 243, 0.34);
    background: rgba(255, 250, 243, 0.1);
    color: #fffaf3;
  }

  .hero-panel {
    border: 1px solid rgba(255, 250, 243, 0.24);
    border-radius: 30px;
    background: rgba(20, 14, 10, 0.78);
    padding: clamp(26px, 4vw, 36px);
    color: #fffaf3;
    box-shadow: 0 32px 90px rgba(17, 11, 8, 0.42);
  }

