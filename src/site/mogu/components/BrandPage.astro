  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      linear-gradient(105deg, var(--hero-a), var(--hero-b) 54%, var(--hero-c)),
      var(--hero-image) center/cover;
  }

  .page-hero::before,
  .page-hero::after {
    position: absolute;
    z-index: -1;
    content: "";
    pointer-events: none;
  }

  .page-hero::before {
    inset: 0;
    background:
      linear-gradient(rgba(255, 250, 243, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 250, 243, 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(90deg, black, transparent 78%);
  }

  .page-hero::after {
    right: -8vw;
    bottom: -18vw;
    width: 42vw;
    height: 42vw;
    border: 1px solid rgba(255, 250, 243, 0.18);
    border-radius: 50%;
    box-shadow: inset 0 0 0 7vw rgba(255, 250, 243, 0.035);
  }

  .page-hero .kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid rgba(255, 250, 243, 0.22);
    border-radius: 999px;
    background: rgba(255, 250, 243, 0.08);
    padding: 9px 13px;
  }

