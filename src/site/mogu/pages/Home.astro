---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { assets, cases, faqs, industries, keywords, process, proof, services } from '../data/landing';

const navItems = [
  ['服务', '#services'],
  ['行业', '#industries'],
  ['方法', '#process'],
  ['案例', '#cases'],
  ['FAQ', '#faq'],
];

const heroImage = 'https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?auto=format&fit=crop&w=1800&q=84';
---

<BaseLayout
  title="蘑菇视频 - 短视频制作、品牌宣传片与内容增长服务"
  description="蘑菇视频为企业、商家和创作者提供短视频制作、品牌宣传片拍摄、AI 视频创作、账号运营复盘与视频内容营销服务。"
  keywords={keywords}
  includeOrgSchema
>
  <header slot="header" class="mogu-nav">
    <a class="brand" href="/" aria-label="蘑菇视频首页">
      <span class="brand-mark"><Icon name="play" size="sm" /></span>
      <span>蘑菇视频</span>
    </a>

    <nav class="desktop-nav" aria-label="首页导航">
      {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>

    <a class="nav-cta" href="#contact">
      <Icon name="send" size="sm" />
      获取内容方案
    </a>
  </header>

  <main class="mogu-page">
    <section class="hero" id="top">
      <div class="hero-media" aria-hidden="true">
        <img src={heroImage} alt="视频后期工作台正在剪辑品牌短片" />
        <div class="hero-wash"></div>
      </div>

      <div class="hero-inner">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow"><span></span> 短视频制作 · 品牌宣传片 · 内容增长</p>
          <h1>把品牌要说的话，拍成用户愿意看完的视频</h1>
          <p class="hero-lede">
            蘑菇视频为企业和商家设计可持续的视频内容系统：先找到用户为什么停留，再决定怎么拍、怎么剪、怎么发布。
          </p>

          <div class="hero-actions">
            <a class="primary-btn" href="#contact">
              预约诊断
              <Icon name="arrow-right" size="sm" />
            </a>
            <a class="ghost-btn" href="#services">
              查看服务
              <Icon name="list-checks" size="sm" />
            </a>
          </div>
        </div>

        <aside class="strategy-card" data-reveal="left" aria-label="首页服务摘要">
          <div class="strategy-top">
            <span>Content Growth Brief</span>
            <Icon name="aperture" size="md" />
          </div>
          <h2>蘑菇视频不是先拍片，而是先定义视频要完成的任务。</h2>
          <ul>
            <li><Icon name="check" size="sm" /> 搜索词与用户意图拆解</li>
            <li><Icon name="check" size="sm" /> 短视频脚本和拍摄清单</li>
            <li><Icon name="check" size="sm" /> 多平台素材和复盘报告</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="proof-strip" aria-label="服务交付数据">
      {proof.map((item) => (
        <div>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </div>
      ))}
    </section>

    <section class="section intro">
      <div class="intro-copy" data-reveal>
        <p class="section-kicker">Brand Video System</p>
        <h2>蘑菇视频解决的是内容长期增长，而不是一次性热闹。</h2>
      </div>
      <p data-reveal="left">
        我们会把品牌搜索、短视频推荐、销售转化和素材复用放在同一张内容地图里，让每条视频都知道自己负责拉新、解释、信任还是成交。
      </p>
    </section>

    <section class="section services" id="services">
      <div class="section-head" data-reveal>
        <p class="section-kicker">服务矩阵</p>
        <h2>蘑菇视频从策略到成片，围绕商业目标组织视频生产</h2>
        <p>蘑菇视频会把搜索需求、平台推荐和销售线索一起纳入交付标准。</p>
      </div>

      <div class="service-grid">
        {services.map((service, index) => (
          <article class="service-card" data-reveal data-reveal-delay={index % 3}>
            <div class="service-icon"><Icon name={service.icon} size="md" /></div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section industries" id="industries">
      <div class="split-head" data-reveal>
        <div>
          <p class="section-kicker">适用行业</p>
          <h2>不同业务，不同视频打法</h2>
        </div>
        <p>蘑菇视频会根据行业决策链路重写脚本结构，而不是套同一套模板。</p>
      </div>

      <div class="industry-list">
        {industries.map(([title, description]) => (
          <article data-reveal>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="method-band" id="process">
      <div class="method-inner">
        <div class="method-copy" data-reveal>
          <p class="section-kicker">方法论</p>
          <h2>蘑菇视频用内容诊断，让拍摄变得可判断</h2>
          <p>蘑菇视频把创意、制作和数据放到同一条工作流里，避免视频上线后只剩“感觉还不错”。</p>
        </div>

        <div class="process-list">
          {process.map(([title, description], index) => (
            <article data-reveal data-reveal-delay={index % 3}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section cases" id="cases">
      <div class="section-head" data-reveal>
        <p class="section-kicker">案例方向</p>
        <h2>蘑菇视频把一次拍摄拆成多种可复用的视频资产</h2>
      </div>

      <div class="case-grid">
        {cases.map((item, index) => (
          <article class="case-card" data-reveal data-reveal-delay={index}>
            <img src={item.image} alt={`${item.title}案例封面`} />
            <div>
              <span>{item.tag}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <strong>{item.result}</strong>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="asset-wall">
      <div class="asset-copy" data-reveal>
        <p class="section-kicker">交付资产</p>
        <h2>蘑菇视频不是只交一条视频，而是交付一组能继续工作的素材。</h2>
      </div>
      <div class="asset-grid" data-reveal="left">
        {assets.map((asset) => <span>{asset}</span>)}
      </div>
    </section>

    <section class="section faq" id="faq">
      <div class="section-head narrow" data-reveal>
        <p class="section-kicker">常见问题</p>
        <h2>关于蘑菇视频的合作边界</h2>
      </div>

      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details data-reveal>
            <summary>{question}<Icon name="chevron-down" size="sm" /></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="final-cta" id="contact">
      <div class="final-bg" aria-hidden="true">
        <img src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1800&q=84" alt="内容团队在会议室讨论视频创作方案" />
      </div>
      <div class="final-panel" data-reveal>
        <p class="section-kicker">项目咨询</p>
        <h2>让蘑菇视频先帮你做一次内容诊断</h2>
        <p>发送品牌、产品、账号链接或现有素材，我们会判断最适合先做哪一类视频内容。</p>
        <div>
          <a class="primary-btn" href="mailto:info@mogu.video">
            发送需求
            <Icon name="mail" size="sm" />
          </a>
          <a class="ghost-btn light" href="#top">
            回到顶部
            <Icon name="arrow-up" size="sm" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer slot="footer" class="mogu-footer">
    <span>蘑菇视频</span>
    <span>短视频制作 · 品牌宣传片 · 内容增长</span>
  </footer>
</BaseLayout>

<style>
  :global(html) {
    scroll-padding-top: 88px;
  }

  :global(body) {
    font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", var(--font-sans), sans-serif;
    background: #fbf7f1;
  }

  .mogu-nav {
    position: fixed;
    top: 18px;
    left: 50%;
    z-index: 50;
    display: flex;
    width: min(1120px, calc(100% - 32px));
    transform: translateX(-50%);
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: rgba(25, 18, 16, 0.7);
    padding: 10px 12px 10px 18px;
    color: #fffaf1;
    box-shadow: 0 24px 70px rgba(33, 20, 12, 0.24);
    backdrop-filter: blur(20px);
  }

  .brand,
  .nav-cta,
  .desktop-nav a,
  .primary-btn,
  .ghost-btn {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand {
    gap: 10px;
    color: #fffaf1;
    font-weight: 950;
    letter-spacing: 0;
  }

  .brand-mark {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 12px;
    background: #ff5c35;
    color: #fffaf1;
  }

  .desktop-nav {
    display: flex;
    gap: 6px;
  }

  .desktop-nav a {
    border-radius: 999px;
    color: rgba(255, 250, 241, 0.76);
    font-size: 14px;
    font-weight: 800;
    padding: 9px 13px;
  }

  .desktop-nav a:hover {
    background: rgba(255, 250, 241, 0.12);
    color: #fffaf1;
  }

  .nav-cta {
    gap: 8px;
    border-radius: 999px;
    background: #fffaf1;
    color: #34231b;
    font-size: 14px;
    font-weight: 950;
    padding: 10px 16px;
  }

  .mogu-page {
    color: #2c211c;
    overflow: hidden;
  }

  .hero {
    position: relative;
    min-height: 94vh;
    overflow: hidden;
    background: #211713;
    color: #fffaf1;
  }

  .hero-media,
  .hero-media img,
  .hero-wash {
    position: absolute;
    inset: 0;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.36;
  }

  .hero-wash {
    background:
      linear-gradient(100deg, rgba(33, 23, 19, 0.96), rgba(33, 23, 19, 0.78) 48%, rgba(255, 92, 53, 0.5)),
      radial-gradient(circle at 82% 18%, rgba(255, 205, 86, 0.34), transparent 34%);
  }

  .hero-inner {
    position: relative;
    display: grid;
    min-height: 94vh;
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    grid-template-columns: minmax(0, 1.05fr) minmax(330px, 0.62fr);
    align-items: center;
    gap: clamp(38px, 7vw, 96px);
    padding: 122px 0 76px;
  }

  .eyebrow,
  .section-kicker {
    margin: 0;
    font-size: 13px;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(255, 250, 241, 0.22);
    border-radius: 999px;
    background: rgba(255, 250, 241, 0.1);
    color: rgba(255, 250, 241, 0.82);
    padding: 10px 14px;
  }

  .eyebrow span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffcd56;
  }

  h1,
  h2,
  h3,
  p {
    letter-spacing: 0;
  }

  .hero h1 {
    max-width: 820px;
    margin: 28px 0 22px;
    font-size: clamp(46px, 8vw, 96px);
    font-weight: 950;
    line-height: 1.02;
  }

  .hero-lede {
    max-width: 640px;
    margin: 0;
    color: rgba(255, 250, 241, 0.74);
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.85;
  }

  .hero-actions,
  .final-panel > div {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .primary-btn,
  .ghost-btn {
    justify-content: center;
    gap: 10px;
    border-radius: 999px;
    font-weight: 950;
    min-height: 54px;
    padding: 0 24px;
    transition: transform 180ms ease, background 180ms ease;
  }

  .primary-btn {
    background: #ff5c35;
    color: #fffaf1;
    box-shadow: 0 20px 44px rgba(255, 92, 53, 0.3);
  }

  .ghost-btn {
    border: 1px solid rgba(255, 250, 241, 0.26);
    background: rgba(255, 250, 241, 0.08);
    color: #fffaf1;
  }

  .primary-btn:hover,
  .ghost-btn:hover,
  .service-card:hover,
  .case-card:hover {
    transform: translateY(-4px);
  }

  .strategy-card {
    border: 1px solid rgba(255, 250, 241, 0.18);
    border-radius: 30px;
    background: rgba(255, 250, 241, 0.12);
    padding: clamp(26px, 4vw, 36px);
    box-shadow: 0 32px 90px rgba(17, 11, 8, 0.34);
    backdrop-filter: blur(18px);
  }

  .strategy-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(255, 250, 241, 0.65);
    font-size: 13px;
    font-weight: 900;
  }

  .strategy-card h2 {
    margin: 30px 0 26px;
    color: #fffaf1;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.16;
  }

  .strategy-card ul {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .strategy-card li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(255, 250, 241, 0.78);
    line-height: 1.5;
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: #2c211c;
  }

  .proof-strip div {
    background: #fffaf1;
    padding: clamp(24px, 4vw, 42px);
  }

  .proof-strip strong {
    display: block;
    color: #ff5c35;
    font-size: clamp(30px, 4vw, 52px);
    font-weight: 950;
  }

  .proof-strip span {
    color: #705f55;
    font-weight: 800;
  }

  .section,
  .asset-wall,
  .method-band {
    padding: clamp(76px, 10vw, 124px) max(24px, calc((100vw - 1180px) / 2));
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.7fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: end;
    background: #fbf7f1;
  }

  .section-kicker {
    color: #d84a28;
  }

  .intro h2,
  .section-head h2,
  .split-head h2,
  .method-copy h2,
  .asset-copy h2,
  .final-panel h2 {
    margin: 12px 0 0;
    font-size: clamp(32px, 5vw, 58px);
    font-weight: 950;
    line-height: 1.09;
  }

  .intro > p,
  .split-head > p,
  .method-copy p:not(.section-kicker),
  .final-panel p:not(.section-kicker) {
    margin: 0;
    color: #705f55;
    font-size: 18px;
    line-height: 1.85;
  }

  .services,
  .faq {
    background: #fffaf1;
  }

  .industries,
  .cases {
    background: #fbf7f1;
  }

  .section-head {
    max-width: 760px;
    margin: 0 auto 44px;
    text-align: center;
  }

  .section-head p:not(.section-kicker) {
    max-width: 660px;
    margin: 18px auto 0;
    color: #705f55;
    font-size: 18px;
    line-height: 1.75;
  }

  .section-head.narrow {
    max-width: 650px;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .service-card,
  .industry-list article,
  .process-list article,
  .faq-list details {
    border: 1px solid rgba(44, 33, 28, 0.1);
    background: #fffdf8;
    box-shadow: 0 18px 50px rgba(44, 33, 28, 0.07);
  }

  .service-card {
    min-height: 226px;
    border-radius: 26px;
    padding: 28px;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .service-icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 16px;
    background: #ffe1d7;
    color: #d84a28;
  }

  .service-card h3,
  .industry-list h3,
  .process-list h3 {
    margin: 20px 0 0;
    font-size: 20px;
    font-weight: 950;
  }

  .service-card p,
  .industry-list p,
  .process-list p,
  .case-card p {
    margin: 12px 0 0;
    color: #705f55;
    line-height: 1.75;
  }

  .split-head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(300px, 0.55fr);
    gap: 30px;
    align-items: end;
    margin-bottom: 34px;
  }

  .industry-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .industry-list article {
    border-radius: 24px;
    padding: 26px;
  }

  .method-band {
    background: #211713;
    color: #fffaf1;
  }

  .method-inner {
    display: grid;
    grid-template-columns: minmax(300px, 0.55fr) minmax(0, 1fr);
    gap: clamp(34px, 6vw, 76px);
    align-items: start;
  }

  .method-copy {
    position: sticky;
    top: 120px;
  }

  .method-copy .section-kicker {
    color: #ffcd56;
  }

  .method-copy p:not(.section-kicker) {
    color: rgba(255, 250, 241, 0.66);
    margin-top: 22px;
  }

  .process-list {
    display: grid;
    gap: 14px;
  }

  .process-list article {
    border-color: rgba(255, 250, 241, 0.14);
    background: rgba(255, 250, 241, 0.08);
    border-radius: 24px;
    padding: 24px;
  }

  .process-list span {
    color: #ffcd56;
    font-weight: 950;
  }

  .process-list p {
    color: rgba(255, 250, 241, 0.66);
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .case-card {
    overflow: hidden;
    border-radius: 30px;
    background: #fffdf8;
    box-shadow: 0 20px 54px rgba(44, 33, 28, 0.08);
    transition: transform 180ms ease;
  }

  .case-card img {
    width: 100%;
    aspect-ratio: 1.22;
    object-fit: cover;
  }

  .case-card div {
    padding: 24px;
  }

  .case-card span {
    display: inline-flex;
    border-radius: 999px;
    background: #ffe1d7;
    color: #b53b20;
    font-size: 12px;
    font-weight: 950;
    padding: 7px 10px;
  }

  .case-card h3 {
    margin: 16px 0 0;
    font-size: 24px;
    font-weight: 950;
  }

  .case-card strong {
    display: block;
    margin-top: 18px;
    color: #d84a28;
  }

  .asset-wall {
    display: grid;
    grid-template-columns: minmax(300px, 0.55fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    background: #fffaf1;
  }

  .asset-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .asset-grid span {
    border: 1px solid rgba(216, 74, 40, 0.24);
    border-radius: 999px;
    background: #fffdf8;
    color: #3d2b23;
    font-weight: 900;
    padding: 13px 16px;
  }

  .faq-list {
    display: grid;
    gap: 14px;
    max-width: 860px;
    margin: 0 auto;
  }

  .faq-list details {
    border-radius: 22px;
    padding: 0 22px;
  }

  .faq-list summary {
    display: flex;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 22px 0;
    color: #2c211c;
    font-weight: 950;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list details[open] summary svg {
    transform: rotate(180deg);
  }

  .faq-list details p {
    margin: 0;
    color: #705f55;
    line-height: 1.75;
    padding: 0 0 22px;
  }

  .final-cta {
